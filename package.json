{
  "name": "factory-bottleneck-experimenter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"vite --host 0.0.0.0\" \"wrangler dev --port 8787\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/run-demo.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.10.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.163.0"
  }
}
